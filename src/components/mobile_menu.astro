---
import NavLinks from './nav_links.astro';
import type { SeriesLink } from '../utils/site';

interface Props {
  series?: SeriesLink[];
}

const { series = [] } = Astro.props;
---

<button
  class="hamburger"
  aria-label="Menu"
  aria-expanded="false"
  aria-controls="mobile-nav"
>
  <svg class="icon-menu" width="2rem" height="2rem" viewBox="0 0 24 18" fill="none" aria-hidden="true">
    <path d="M0 1.5h24M0 9h24M0 16.5h24" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"></path>
  </svg>
  <svg class="icon-close" width="2rem" height="2rem" viewBox="0 0 24 18" fill="none" aria-hidden="true">
    <path d="M3 0l18 18M21 0L3 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"></path>
  </svg>
</button>

<div class="mobile-nav" id="mobile-nav">
  <nav>
    <NavLinks series={series} stagger />
  </nav>
</div>

<style>
  .hamburger {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: grid;
    place-items: center;
    color: var(--color-text);
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .hamburger:hover {
    color: var(--color-hover);
  }

  /* Scale + blur icon swap, after transitions.dev/icon-swap */
  .hamburger svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.25s,
      scale 0.25s,
      filter 0.25s;
    transition-timing-function: var(--ease-out);
  }

  .icon-close,
  .hamburger[aria-expanded='true'] .icon-menu {
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  .hamburger[aria-expanded='true'] .icon-close {
    opacity: 1;
    scale: 1;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger svg {
      transition: opacity 0.15s;
    }

    .icon-close,
    .hamburger[aria-expanded='true'] .icon-menu {
      scale: 1;
      filter: none;
    }
  }

  .mobile-nav {
    --menu-section-gap: 2.5rem;
    --menu-item-gap: 0.5rem;
    display: none;
    position: fixed;
    top: 5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-bg);
    padding: 1rem;
    z-index: 99;
    text-align: right;
    font-size: 1.3rem;
  }

  .mobile-nav.open {
    display: block;
  }

  /* Panel fades in, links follow in a quick cascade; closing is faster, as one piece */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav.open {
      animation: menu-in 0.2s var(--ease-out);
    }

    .mobile-nav.open :global(:is(li, .menu-section:not(:first-child))) {
      animation: menu-in 0.3s var(--ease-out) calc(var(--i) * 25ms) backwards;
    }

    .mobile-nav.closing {
      display: block;
      animation: menu-out 0.15s var(--ease-out) forwards;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -0.4rem;
    }
  }

  @keyframes menu-out {
    to {
      opacity: 0;
      translate: 0 -0.4rem;
    }
  }
</style>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

  function setOpen(open: boolean) {
    mobileNav?.classList.toggle('open', open);
    mobileNav?.classList.toggle('closing', !open);
    hamburger?.setAttribute('aria-expanded', String(open));
  }

  // Only the panel's own close animation; link animations bubble up here too
  mobileNav?.addEventListener('animationend', (event) => {
    if (event.target === mobileNav) mobileNav.classList.remove('closing');
  });

  hamburger?.addEventListener('click', () => {
    setOpen(!mobileNav?.classList.contains('open'));
  });

  // Close on Escape, and return focus to the button that opened the menu
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav?.classList.contains('open')) {
      setOpen(false);
      hamburger?.focus();
    }
  });

  // Close when navigating to one of the links inside the menu
  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
