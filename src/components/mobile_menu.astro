---
import { base, type SeriesLink } from '../utils/site';

interface Props {
  series?: SeriesLink[];
}

const { series = [] } = Astro.props;
const currentPath = Astro.url.pathname;
---

<button
  class="hamburger"
  aria-label="Menu"
  aria-expanded="false"
  aria-controls="mobile-nav"
>
  <svg class="icon-menu" width="2rem" height="2rem" viewBox="0 0 24 18" fill="none" aria-hidden="true">
    <path d="M0 1.5h24M0 9h24M0 16.5h24" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"></path>
  </svg>
  <svg class="icon-close" width="2rem" height="2rem" viewBox="0 0 24 18" fill="none" aria-hidden="true">
    <path d="M3 0l18 18M21 0L3 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"></path>
  </svg>
</button>

<div class="mobile-nav" id="mobile-nav">
  <nav>
    <div class="menu-section">
      {
        series.length > 0 && (
          <ul class="series-list">
            {series.map((item, i) => (
              <li style={`--i: ${i}`}>
                <a
                  href={`${base}series/${item.slug}`}
                  class:list={[
                    { active: currentPath === `${base}series/${item.slug}` },
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="menu-section" style={`--i: ${series.length}`}>
      <a
        href={`${base}about`}
        class:list={[{ active: currentPath === `${base}about` }]}
      >
        About
      </a>
    </div>

    <div class="menu-section" style={`--i: ${series.length + 1}`}>
      <a href="mailto:heintz.leslie@gmail.com" class="contact-link">
        Contact
      </a>
    </div>
  </nav>
</div>

<style>
  .hamburger {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: grid;
    place-items: center;
    color: #222;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .hamburger:hover {
    color: #444;
  }

  /* Scale + blur icon swap, after transitions.dev/icon-swap */
  .hamburger svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.25s,
      scale 0.25s,
      filter 0.25s;
    transition-timing-function: var(--ease-out);
  }

  .icon-close,
  .hamburger[aria-expanded='true'] .icon-menu {
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  .hamburger[aria-expanded='true'] .icon-close {
    opacity: 1;
    scale: 1;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger svg {
      transition: opacity 0.15s;
    }

    .icon-close,
    .hamburger[aria-expanded='true'] .icon-menu {
      scale: 1;
      filter: none;
    }
  }

  .mobile-nav {
    --mobile-menu-font-size: 1.3rem;
    --mobile-menu-spacing: 0.5rem;
    display: none;
    position: fixed;
    top: 5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background: white;
    padding: 1rem;
    z-index: 99;
    text-align: right;
    font-size: var(--mobile-menu-font-size);
  }

  .mobile-nav.open {
    display: block;
  }

  /* Panel fades in, links follow in a quick cascade; closing is faster, as one piece */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav.open {
      animation: menu-in 0.2s var(--ease-out);
    }

    .mobile-nav.open :is(li, .menu-section:not(:first-child)) {
      animation: menu-in 0.3s var(--ease-out) calc(var(--i) * 25ms) backwards;
    }

    .mobile-nav.closing {
      display: block;
      animation: menu-out 0.15s var(--ease-out) forwards;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -0.4rem;
    }
  }

  @keyframes menu-out {
    to {
      opacity: 0;
      translate: 0 -0.4rem;
    }
  }

  .menu-section {
    margin-bottom: 2.5rem;
  }

  .series-list {
    list-style: none;
    padding-right: 0;
    text-align: right;
  }

  .series-list li {
    margin-bottom: var(--mobile-menu-spacing);
  }

  .active {
    font-weight: 600;
  }
</style>

<script>
  const hamburger = document.querySelector('.hamburger');
  const mobileNav = document.querySelector('.mobile-nav');

  function setOpen(open: boolean) {
    mobileNav?.classList.toggle('open', open);
    mobileNav?.classList.toggle('closing', !open);
    hamburger?.setAttribute('aria-expanded', String(open));
  }

  mobileNav?.addEventListener('animationend', () => {
    mobileNav.classList.remove('closing');
  });

  hamburger?.addEventListener('click', () => {
    setOpen(!mobileNav?.classList.contains('open'));
  });

  // Close on Escape, and return focus to the button that opened the menu
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav?.classList.contains('open')) {
      setOpen(false);
      (hamburger as HTMLButtonElement | null)?.focus();
    }
  });

  // Close when navigating to one of the links inside the menu
  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
