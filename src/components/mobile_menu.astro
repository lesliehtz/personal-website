---
import { base, type SeriesLink } from '../utils/site';

interface Props {
  series?: SeriesLink[];
}

const { series = [] } = Astro.props;
const currentPath = Astro.url.pathname;
---

<button
  class="hamburger"
  aria-label="Menu"
  aria-expanded="false"
  aria-controls="mobile-nav"
>
  <svg
    width="2rem"
    height="2rem"
    viewBox="0 0 24 18"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0 1.5h24M0 9h24M0 16.5h24"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="square"></path>
  </svg>
</button>

<div class="mobile-nav" id="mobile-nav">
  <nav>
    <div class="menu-section">
      {
        series.length > 0 && (
          <ul class="series-list">
            {series.map((item) => (
              <li>
                <a
                  href={`${base}series/${item.slug}`}
                  class:list={[
                    { active: currentPath === `${base}series/${item.slug}` },
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="menu-section">
      <a
        href={`${base}about`}
        class:list={[{ active: currentPath === `${base}about` }]}
      >
        About
      </a>
    </div>

    <div class="menu-section">
      <a href="mailto:heintz.leslie@gmail.com" class="contact-link">
        Contact
      </a>
    </div>
  </nav>
</div>

<style>
  .hamburger {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #222;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .hamburger:hover {
    color: #444;
  }

  .mobile-nav {
    --mobile-menu-font-size: 1.3rem;
    --mobile-menu-spacing: 0.5rem;
    display: none;
    position: fixed;
    top: 5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background: white;
    padding: 1rem;
    z-index: 99;
    text-align: right;
    font-size: var(--mobile-menu-font-size);
  }

  .mobile-nav.open {
    display: block;
  }

  .menu-section {
    margin-bottom: 2.5rem;
  }

  .series-list {
    list-style: none;
    padding-right: 0;
    text-align: right;
  }

  .series-list li {
    margin-bottom: var(--mobile-menu-spacing);
  }

  .active {
    font-weight: 600;
  }
</style>

<script>
  const hamburger = document.querySelector('.hamburger');
  const mobileNav = document.querySelector('.mobile-nav');

  function setOpen(open: boolean) {
    mobileNav?.classList.toggle('open', open);
    hamburger?.setAttribute('aria-expanded', String(open));
  }

  hamburger?.addEventListener('click', () => {
    setOpen(!mobileNav?.classList.contains('open'));
  });

  // Close on Escape, and return focus to the button that opened the menu
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav?.classList.contains('open')) {
      setOpen(false);
      (hamburger as HTMLButtonElement | null)?.focus();
    }
  });

  // Close when navigating to one of the links inside the menu
  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
