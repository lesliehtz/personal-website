---
import NavLinks from './nav_links.astro';
import type { SeriesLink } from '../utils/site';

interface Props {
  series?: SeriesLink[];
}

const { series = [] } = Astro.props;
---

<nav class="side-menu">
  <NavLinks series={series} />
</nav>

<style>
  .side-menu {
    text-align: left;
  }
</style>
