---
import { base, type SeriesLink } from '../utils/site';

interface Props {
  series?: SeriesLink[];
}

const { series = [] } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav class="side-menu">
  <div class="menu-section">
    {
      series.length > 0 && (
        <ul class="series-list">
          {series.map((item) => (
            <li>
              <a
                href={`${base}series/${item.slug}`}
                class:list={[
                  { active: currentPath === `${base}series/${item.slug}` },
                ]}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="menu-section">
    <a
      href={`${base}about`}
      class:list={[{ active: currentPath === `${base}about` }]}
    >
      About
    </a>
  </div>

  <div class="menu-section">
    <a href="mailto:heintz.leslie@gmail.com" class="contact-link"> Contact </a>
  </div>
</nav>

<style>
  .side-menu {
    text-align: left;
  }

  .menu-section {
    margin-bottom: 1.5rem;
  }

  .series-list {
    list-style: none;
    padding-left: 0;
  }

  .series-list li {
    margin-bottom: 0.25rem;
  }

  .active {
    font-weight: 600;
  }
</style>

<!-- fixed side menu for navigation -->
