---
import BaseLayout from './base_layout.astro';
import SeriesMeta from '../components/series_meta.astro';
import PhotoGrid from '../components/photo_grid.astro';
import type { SeriesLink } from '../utils/site';

interface Props {
  title: string;
  date: string;
  description: string;
  series: SeriesLink[];
  seriesSlug: string;
  image?: string;
}

const { title, date, description, series, seriesSlug, image } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={date}
  series={series}
>
  <SeriesMeta title={title} date={date} description={description} />
  <PhotoGrid seriesSlug={seriesSlug} seriesTitle={title} />
  <slot />
</BaseLayout>
