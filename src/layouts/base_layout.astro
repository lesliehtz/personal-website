---
import type { ComponentProps } from 'astro/types';
import Head from '../components/Head.astro';
import Header from '../components/header.astro';
import SideMenu from '../components/side_menu.astro';
import MobileMenu from '../components/mobile_menu.astro';
import Footer from '../components/footer.astro';
import type { SeriesLink } from '../utils/site';
import '../styles/global.css';

type Props = ComponentProps<typeof Head> & {
  series?: SeriesLink[];
};

const { series = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...seo} />
    <script is:inline>
      document.documentElement.classList.add('js');

      // Fade photos up once in view and decoded; the wait is capped so nothing feels slow.
      addEventListener('DOMContentLoaded', () => {
        const io = new IntersectionObserver(
          (entries) => {
            entries
              .filter((e) => e.isIntersecting)
              .forEach((e, i) => {
                io.unobserve(e.target);
                const decoded = e.target.querySelector('img')?.decode();
                const timeout = new Promise((r) => setTimeout(r, 800));
                Promise.race([decoded?.catch(() => {}), timeout]).then(() => {
                  e.target.style.transitionDelay = `calc(var(--reveal-offset, 0s) + ${Math.min(i, 4) * 60}ms)`;
                  e.target.classList.add('in');
                });
              });
          },
          { threshold: 0.1 }
        );
        document
          .querySelectorAll('[data-reveal]')
          .forEach((el) => io.observe(el));
      });
    </script>
    <script is:inline>
      // Only load analytics on the online website.
      const host = window.location.hostname;
      if (host !== 'leslieheintz.com' && host !== 'www.leslieheintz.com')
        window.goatcounter = { no_onload: true };
    </script>
    <script
      is:inline
      data-goatcounter="https://lesliehtz.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
  </head>
  <body>
    <div class="mobile-header">
      <Header />
      <MobileMenu series={series} />
    </div>
    <div class="layout">
      <aside class="sidebar">
        <Header />
        <SideMenu series={series} />
      </aside>
      <main class="content">
        <div class="content-wrapper">
          <slot />
        </div>
        <Footer />
      </main>
    </div>
  </body>
</html>

<style>
  html,
  body {
    width: 100%;
    height: 100%;
  }

  .mobile-header {
    display: none;
  }

  .layout {
    --sidebar-width: 23%;
    display: grid;
    grid-template-columns: var(--sidebar-width) 1fr;
    min-height: 100vh;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    padding: 1.7rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .content {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 2rem;
  }

  .content-wrapper {
    flex: 1;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .mobile-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 1rem;
      background: var(--color-bg);
      z-index: 100;
    }

    .sidebar {
      display: none;
    }

    .layout {
      grid-template-columns: 1fr;
    }

    .content {
      grid-column: 1;
      padding: 1rem;
      padding-top: 5.5rem; /* Account for fixed header + slight margin */
    }
  }
</style>
