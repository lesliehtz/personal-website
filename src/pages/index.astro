---
import BaseLayout from '../layouts/base_layout.astro';
import HomeGrid from '../components/home_grid.astro';
import { getSeriesNav } from '../utils/site';

const seriesData = await getSeriesNav();
---

<BaseLayout
  title="Leslie Heintz"
  description="Portfolio of Leslie Heintz, French creative based in Singapore. Exploring architecture, nature and everyday life through photography."
  series={seriesData}
>
  <p class="hero-sentence">
    French creative exploring architecture, nature and everyday life.
  </p>
  <HomeGrid />
</BaseLayout>
