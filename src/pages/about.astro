---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/base_layout.astro';
import aboutImage from '../assets/about.jpg';

const allSeries = await getCollection('series');
const seriesData = allSeries.map((s) => ({
  title: s.data.title,
  slug: s.id,
}));
---

<BaseLayout
  title="About - Leslie Heintz"
  description="French creative based in Singapore. Engineer and architect by training, exploring the intersections of architecture, nature and everyday life."
  series={seriesData}
>
  <div class="about-container">
    <div class="about-content">
      <div class="bio-section">
        <p>
          I am a French creative currently based in Singapore. My work
          explores the intersections of architecture, nature and everyday
          life.
        </p>

        <p>
          I was trained as an engineer and architect, which probably explains my
          endless curiosity about how the world works. I love getting into
          design, programming, and all things tech, to name a few. I enjoy the
          balance between technical thinking and aesthetic vision.
        </p>

        <p>
          I am part of the photographers who <a
            href="https://dontfeellikeposting.online"
            target="_blank"
            rel="noopener noreferrer"
            class="underline">don't feel like posting</a
          >.
        </p>

        <div class="photo-credit">
          <Image
            src={aboutImage}
            alt="Leslie Heintz portrait"
            class="about-image"
            loading="eager"
            quality={85}
            widths={[480, 768, 1024, 1536]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
          <p class="mono">
            Photo by <a href="https://tomthiercelin.com">Tom Thiercelin</a>
          </p>
        </div>
      </div>

      <div class="right-column">
        <div class="features-section">
          <h2>Features</h2>
          <p>
            <a
              href="https://noicemagazine.com/LESLIE-HEINTZ"
              target="_blank"
              rel="noopener noreferrer">Noice Magazine</a
            > - 2025<br />
            <a
              href="https://dontfeellikeposting.online"
              target="_blank"
              rel="noopener noreferrer">don't feel like posting</a
            > - 2025<br />
            <a
              href="https://www.ephemere.tokyo/open-calls/open-call-5"
              target="_blank"
              rel="noopener noreferrer">Ephemere Tokyo</a
            > - 2024<br />
            <a
              href="https://linktr.ee/spreadthefuture"
              target="_blank"
              rel="noopener noreferrer">Spread The Future Podcast</a
            > - 2022<br />
            Le Diaph' - 2020
          </p>
        </div>
        <div class="find-me">
          <h2>Find me online</h2>
          <p>
            <a
              href="https://www.are.na/leslie-heintz/index"
              target="_blank"
              rel="noopener noreferrer"
              ><svg
                class="social-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 150 88.25"
                width="16"
                height="16"
                fill="currentColor"
                ><path
                  d="M148.93 62.356l-20.847-16.384c-1.276-1-1.276-2.642 0-3.645l20.848-16.38c1.28-1.002 1.815-2.695 1.19-3.76-.626-1.062-2.374-1.44-3.88-.84l-24.79 9.874c-1.507.606-2.927-.22-3.153-1.83L114.57 2.926C114.34 1.317 113.13 0 111.877 0c-1.247 0-2.456 1.317-2.68 2.925l-3.73 26.467c-.228 1.61-1.646 2.434-3.155 1.83l-24.38-9.71c-1.512-.602-3.975-.602-5.483 0l-24.384 9.71c-1.508.604-2.928-.22-3.154-1.83L41.186 2.925C40.956 1.317 39.748 0 38.5 0c-1.252 0-2.463 1.317-2.688 2.925l-3.73 26.467c-.226 1.61-1.645 2.434-3.153 1.83L4.14 21.35c-1.507-.603-3.252-.223-3.878.838-.625 1.066-.092 2.76 1.184 3.76l20.85 16.38c1.277 1.003 1.277 2.645 0 3.646L1.446 62.356C.166 63.358-.364 65.152.26 66.34c.627 1.19 2.372 1.668 3.877 1.064l24.567-9.866c1.51-.603 2.914.218 3.125 1.828l3.544 26.696c.214 1.607 1.618 2.923 3.12 2.923 1.5 0 2.905-1.315 3.12-2.923l3.55-26.696c.21-1.61 1.62-2.43 3.122-1.828l24.164 9.698c1.506.606 3.97.606 5.477 0l24.16-9.698c1.504-.603 2.91.218 3.125 1.828l3.55 26.696c.212 1.607 1.617 2.923 3.115 2.923 1.502 0 2.907-1.315 3.12-2.923l3.55-26.696c.216-1.61 1.62-2.43 3.124-1.828l24.57 9.866c1.5.604 3.25.125 3.876-1.063.627-1.186.094-2.98-1.185-3.982zM95.89 46.18L77.53 60.315c-1.285.99-3.393.99-4.674 0L54.49 46.18c-1.284-.99-1.294-2.62-.02-3.625l18.4-14.493c1.274-1.005 3.363-1.005 4.638 0l18.4 14.493c1.277 1.004 1.267 2.634-.02 3.626z"
                ></path></svg
              >
              Are.na</a
            ><br />
            <a
              href="https://the.fotoapp.co/lesliehtz"
              target="_blank"
              rel="noopener noreferrer"
              ><span class="social-icon" style="font-family: 'EB Garamond', serif; font-weight: bold; font-size: 18px; display: inline-block; width: 16px; text-align: center;">f</span>
              Foto</a
            ><br />
            <a
              href="https://www.linkedin.com/in/leslie-heintz/"
              target="_blank"
              rel="noopener noreferrer"
              ><svg
                class="social-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="currentColor"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path></svg
              >
              LinkedIn</a
            ><br />
            <a
              href="https://github.com/lesliehtz"
              target="_blank"
              rel="noopener noreferrer"
              ><svg
                class="social-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="currentColor"
                ><path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.082-.73.082-.73 1.205.085 1.84 1.238 1.84 1.238 1.07 1.835 2.807 1.305 3.492.997.108-.775.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.468-2.382 1.236-3.222-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.3 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.913 1.235 3.222 0 4.61-2.807 5.62-5.48 5.92.43.37.814 1.102.814 2.222 0 1.605-.015 2.898-.015 3.293 0 .32.218.694.825.576C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"
                ></path></svg
              >
              GitHub</a
            >
          </p>
        </div>
        <div class="credits-section">
          <h2 class="mono">Credits</h2>
          <p class="mono">
            <a
              href="https://rsms.me/inter/"
              target="_blank"
              rel="noopener noreferrer">Inter font</a
            > by <a
              href="https://rsms.me"
              target="_blank"
              rel="noopener noreferrer">Rasmus Andersson</a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 100%;
  }

  .about-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
  }

  .bio-section p {
    margin-bottom: 1.5rem;
  }

  .bio-section p:last-child {
    margin-bottom: 0;
  }

  .features-section h2 {
    margin-bottom: 1rem;
  }

  .find-me {
    margin-top: 3rem;
  }

  .find-me h2 {
    margin-bottom: 1rem;
  }

  .credits-section {
    margin-top: 3rem;
  }

  .credits-section h2 {
    margin-bottom: 1rem;
  }

  .photo-credit {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .about-image {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .underline {
    text-decoration: underline;
  }

  .social-icon {
    display: inline-block;
    vertical-align: baseline;
    margin-right: 0.2rem;
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .credits {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
