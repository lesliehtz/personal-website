---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title="404 - Page Not Found | Leslie Heintz"
      description="Page not found"
      noindex={true}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Inconsolata:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="not-found">
      <p class="mono">404</p>
      <p class="mono">Oops, nothing here...</p>
      <p class="mono">
        <a href={import.meta.env.BASE_URL}>Return to civilization ➔</a>
      </p>
    </div>
  </body>
</html>

<style>
  body {
    background-color: #ffffff;
    margin: 0;
    padding: 0;
  }

  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    gap: 1rem;
  }

  .mono {
    text-align: center;
    font-size: 1.5rem;
  }

  a {
    text-decoration: underline;
    text-underline-offset: 0.5rem;
  }
</style>
