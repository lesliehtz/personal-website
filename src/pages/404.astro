---
import Head from '../components/Head.astro';
import { base } from '../utils/site';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="404 - Page Not Found | Leslie Heintz"
      description="Page not found"
      noindex={true}
    />
  </head>
  <body>
    <div class="not-found">
      <p class="mono">404</p>
      <p class="mono">Oops, nothing here...</p>
      <p class="mono">
        <a href={base}>Return to civilization ➔</a>
      </p>
    </div>
  </body>
</html>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    gap: 1rem;
  }

  .mono {
    text-align: center;
    font-size: 1.5rem;
  }

  a {
    text-decoration: underline;
    text-underline-offset: 0.5rem;
  }
</style>
