---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import SeriesLayout from '../../layouts/series_layout.astro';
import { getSeriesImages, getSeriesNav } from '../../utils/site';

export async function getStaticPaths() {
  const allSeries = await getCollection('series');
  return allSeries.map((entry) => ({
    params: { series: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const seriesData = await getSeriesNav();

// The series' first photo becomes its link-preview (Open Graph) image
const [cover] = await getSeriesImages(entry.id);
const ogImage = cover
  ? await getImage({ src: cover, width: 1200, format: 'jpg' })
  : undefined;
---

<SeriesLayout
  title={entry.data.title}
  date={entry.data.date}
  description={entry.data.description || ''}
  series={seriesData}
  seriesSlug={entry.id}
  image={ogImage?.src}
/>
